FASTLLM_API_KEY=
FASTLLM_BASE_URL=https://fastllm.top/v1
FASTLLM_MODEL=auto
# Cloudflare Workers AI is tried first; Pollinations.ai is the no-key fallback.
IMAGE_PROVIDER=cloudflare
# Cloud generation means PyTorch is not required on Railway or on the phone controlling Telegram.
# fal.ai hosts Kling, Hailuo, PixVerse, Vidu, Dreamina/Seedance and Veo APIs; each provider may cost money.
# Google Flow's consumer website is not automated; "veo" uses Google's Veo model through fal.ai.
# VIDEO_PROVIDER: none (2.5D parallax) | kling | hailuo | pixverse | vidu | dreamina | veo | runway | fal | hf
VIDEO_PROVIDER=none
FAL_KEY=
# Custom model endpoint used only when VIDEO_PROVIDER=fal; defaults to Kling 2.1 standard.
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# Direct Runway API key; separate from consumer-app credits.
RUNWAY_API_KEY=
# RUNWAY_VIDEO_MODEL=gen4_turbo
# Shared daily scene-request cap across image-to-video APIs; failed API attempts count too.
VIDEO_API_MAX_SCENES_PER_DAY=8
# Conservative estimated-spend guard; actual provider billing can differ.
VIDEO_API_DAILY_BUDGET_USD=10
# Optional per-scene estimate overrides: VIDEO_ESTIMATED_COST_KLING_USD, ..._VEO_USD, ..._RUNWAY_USD
# HF_SPACE=Lightricks/ltx-video-distilled
# HF_API_NAME=/image_to_video
# HF_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
APP_API_KEY=
PUBLIC_BASE_URL=https://your-railway-domain
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATA_DIR=/app/data
DAILY_AR_TIME=12:00
DAILY_EN_TIME=14:00
# Set to ar to generate only one Arabic episode per day.
DAILY_LANGUAGES=ar,en
# Leave unset to rotate through 12 built-in themes
DAILY_TOPIC=
# Optional licensed music file path on persistent storage
BACKGROUND_MUSIC_PATH=
# VOICE_AR=ar-SA-HamedNeural
# VOICE_EN=en-US-GuyNeural
# VOICE_RATE=-5%
# VOICE_PITCH=+0Hz

# CONTENT_MODE: song (default; 16:9 sing-along kids song video, ~1-2 min) | story
CONTENT_MODE=song
# SONG_PROVIDER: tts (free; child-like voice over synthesized backing) | fal (AI-sung song via fal.ai ACE-Step, needs FAL_KEY)
SONG_PROVIDER=tts
# FAL_MUSIC_MODEL=fal-ai/ace-step
# VOICE_SONG_EN=en-US-AnaNeural
# VOICE_SONG_AR=ar-SA-ZariyahNeural

# Optional automatic nursery-rhyme pipeline. Existing variables remain supported.
# BOT_TOKEN can be used instead of TELEGRAM_BOT_TOKEN.
BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. ADMIN_TELEGRAM_ID also remains supported.
ADMIN_IDS=
CHANNEL_ID=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
HF_TOKEN=
# Google web OAuth client JSON on persistent storage, or use GOOGLE_CLIENT_ID/SECRET above.
YOUTUBE_CLIENT_SECRET=
MAX_UPLOADS_PER_DAY=1
# library | generate | auto; local MusicGen is used for generate and auto.
MUSIC_MODE=library
MUSIC_LIBRARY_PATH=
# Only set to 1 after verifying that your use complies with MusicGen's CC-BY-NC-4.0 license.
MUSICGEN_NONCOMMERCIAL_CONFIRMED=0
