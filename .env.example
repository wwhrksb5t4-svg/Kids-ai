FASTLLM_API_KEY=
FASTLLM_BASE_URL=https://fastllm.top/v1
FASTLLM_MODEL=auto
# Use cloudflare for generated scene illustrations; cards preserves the original renderer.
IMAGE_PROVIDER=cards
# Set VIDEO_PROVIDER=fal (needs IMAGE_PROVIDER=cloudflare) to animate each scene with fal.ai image-to-video
# VIDEO_PROVIDER: none | fal (paid) | hf (free Hugging Face Space, slow, falls back to zoom)
VIDEO_PROVIDER=none
# HF_SPACE=Lightricks/ltx-video-distilled
# HF_API_NAME=/image_to_video
# HF_TOKEN=
FAL_KEY=
# FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
APP_API_KEY=
PUBLIC_BASE_URL=https://your-railway-domain
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATA_DIR=/app/data
DAILY_AR_TIME=12:00
DAILY_EN_TIME=14:00
# Leave unset to rotate through 12 built-in themes
DAILY_TOPIC=
# Optional licensed music file path on persistent storage
BACKGROUND_MUSIC_PATH=
# VOICE_AR=ar-SA-HamedNeural
# VOICE_EN=en-US-GuyNeural
# VOICE_RATE=-5%
# VOICE_PITCH=+0Hz

# CONTENT_MODE: song (default; 16:9 sing-along kids song video, ~1-2 min) | story
CONTENT_MODE=song
# SONG_PROVIDER: tts (free; child-like voice over synthesized backing) | fal (AI-sung song via fal.ai ACE-Step, needs FAL_KEY)
SONG_PROVIDER=tts
# FAL_MUSIC_MODEL=fal-ai/ace-step
# VOICE_SONG_EN=en-US-AnaNeural
# VOICE_SONG_AR=ar-SA-ZariyahNeural
